{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NetObserver: Build and Test",
      "type": "process",
      "command": "${workspaceFolder}\\scripts\\build-vs-cmake.cmd",
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "NetObserver: Run GUI",
      "type": "process",
      "command": "${workspaceFolder}\\build\\vs\\Debug\\NetObserver.exe",
      "dependsOn": "NetObserver: Build and Test",
      "problemMatcher": []
    },
    {
      "label": "NetObserver: List Adapters",
      "type": "process",
      "command": "${workspaceFolder}\\build\\vs\\Debug\\netobserver-cli.exe",
      "args": ["--list"],
      "dependsOn": "NetObserver: Build and Test",
      "problemMatcher": []
    }
  ]
}

